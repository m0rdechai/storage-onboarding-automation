# =============================================================================
# example.env — copy to env/cloud<NN>.env
#
#   setup-storage-lta.sh -e env/cloud<NN>.env <stage>
#
# CLOUD_ID and STORAGE_ARRAYS are required.
# A commented assignment is the script default. Uncomment it to override.
# Put GOVC_URL, GOVC_USERNAME, GOVC_PASSWORD, GOVC_INSECURE, and
# BWS_ACCESS_TOKEN in the shell.
# =============================================================================

# Cloud number, 1-99. VLAN is digit*100+id. Subnet is
# 172.(15+digit).(100+id).0/24. QUADS calls this cloud cloudNN.
CLOUD_ID=06

# Arrays to configure, in this order. Each gets a path A and a path B VLAN.
# Names: ibm, netapp-asa, pure, netapp-aff
STORAGE_ARRAYS="ibm netapp-aff netapp-asa pure"

# BIOS NIC numbers for OCP and bare metal. The first two become emN.
# Odd positions in STORAGE_ARRAYS put path A on the first NIC.
# Even positions swap the two paths. VMware host-setup does not read this.
# NETWORKS="3 4"

# Substring matched against the QUADS hostname or the vCenter inventory path.
# EXCLUDE_HOSTS=""

# ocp     OpenShift: NNCP, oc debug, SSH user core, multipath MachineConfig
# vmware  ESXi through govc. No SSH and no multipath.conf.
# bare    SSH and nmcli, SSH user root
# TARGET_TYPE="ocp"

# Empty uses the SSH user from TARGET_TYPE.
# SSH_USER=""

# ESXi hosts are the HostSystem objects under this folder.
# -w and EXCLUDE_HOSTS narrow that list.
# VMWARE_HOST_FOLDER="/Perf/host/MTV"

# When ibm and ibm2 exist, use their vSwitch and the one active uplink on
# each. When either portgroup is missing, create portgroups on the anchor
# vSwitch. The anchor must not own the VM network portgroup.
# A host whose anchor does not have exactly two uplinks needs one map entry.
# The key is the first label of the vCenter object name:
#   shortname=uplinkA:uplinkB
#   shortname=vSwitch:uplinkA:uplinkB
# VMWARE_HOST_MAP=""
# VMWARE_ANCHOR_VSWITCH="vSwitch2"
# VMWARE_VM_PORTGROUP="VM Network"

# VMWARE_HOST_DOMAIN and VMWARE_HOST_ALIAS are ignored.

# Software iSCSI adapter, and storage-setup govc limits. Times are seconds.
# After REDISCOVER_TIMEOUT, adapter get is polled every POLL_INTERVAL for
# up to POLL_WINDOW. JOB_PARALLEL is how many hosts run at once.
# host-setup does not use the timeouts.
# VMWARE_ISCSI_ADAPTER="vmhba64"
# VMWARE_ADAPTER_GET_TIMEOUT=60
# VMWARE_SENDTARGET_LIST_TIMEOUT=60
# VMWARE_SENDTARGET_ADD_TIMEOUT=120
# VMWARE_SESSION_LIST_TIMEOUT=60
# VMWARE_REDISCOVER_TIMEOUT=900
# VMWARE_ADAPTER_POLL_INTERVAL=30
# VMWARE_ADAPTER_POLL_WINDOW=300
# VMWARE_JOB_PARALLEL=4

# Seconds to wait for the OpenShift worker pool after the multipath
# MachineConfig. A new or changed MachineConfig reboots that pool.
# MCP_WAIT_TIMEOUT=3600

# Scope `bws secret list` to one project. Empty reads every secret the
# token can see.
# BWS_PROJECT_ID=""

# QUADS base URL for OCP and bare metal.
# QUADS_API="https://quads2.rdu2.scalelab.redhat.com/api/v3"

# Outer VLAN written into the jira-draft quads commands.
# CLOUD99_OUTER_VLAN="2080"

# Size and count of each storage-setup volume or LUN. Suffixes are 01, 02, ...
LUN_SIZE="1TB"
LUN_COUNT=1
